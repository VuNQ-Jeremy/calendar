{
  // Minimal wrangler config for worker tests — no ASSETS binding needed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar",
  "compatibility_date": "2026-06-23",
  // Required for server/services/audit.ts's AsyncLocalStorage import — without it every test
  // that touches the service layer fails to even load.
  "compatibility_flags": ["nodejs_als"],
  "main": "worker/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mochi-class",
      "database_id": "26f4f6f7-0fce-4b33-b02a-38722c780c5e",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "mochi-files",
    },
  ],
  // vitest-pool-workers instantiates Durable Objects from this config's `main`,
  // so the class is re-exported by worker/index.js as well.
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_HUB", "class_name": "LiveHub" },
      { "name": "ZALO_POLLER", "class_name": "ZaloPoller" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub", "ZaloPoller"] }],
}
