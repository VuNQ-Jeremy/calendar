# Copy to `.env.local` for `npx expo start`. EAS builds read the same variable from the build
# profile's `env` block in eas.json — set it in BOTH places or a build will point at nothing.
#
# EXPO_PUBLIC_* is INLINED INTO THE BUNDLE at build time and is public. A base URL is fine.
# Never put a secret in one.
EXPO_PUBLIC_API_URL=https://calendar.ngqv0712.workers.dev
