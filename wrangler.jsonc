{
  // Cloudflare Workers config for Mochi.
  //
  // The Worker (worker/index.js) serves the built SPA via the ASSETS binding and
  // a JSON API at /api/* backed by D1 (the DB binding).
  //
  // The D1 database is provisioned. To apply the schema to it, run:
  //   npm run db:migrate         (remote)   /   npm run db:migrate:local
  // See BACKEND.md for details.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar",
  "compatibility_date": "2026-06-23",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mochi-class",
      "database_id": "26f4f6f7-0fce-4b33-b02a-38722c780c5e",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
