{
  "name": "mochi-lms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mochi — a warm, family-friendly learning management calendar app",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:deploy": "wrangler deploy",
    "typecheck": "react-router typegen && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create mochi-class",
    "db:migrate:local": "wrangler d1 migrations apply mochi-class --local",
    "db:migrate": "wrangler d1 migrations apply mochi-class --remote",
    "db:seed:local": "wrangler d1 execute mochi-class --local --file=./seed.sql",
    "db:seed": "wrangler d1 execute mochi-class --remote --file=./seed.sql",
    "lint": "oxlint src worker workers app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && vitest run --config vitest.workers.config.js",
    "test:watch": "vitest",
    "test:worker": "vitest run --config vitest.workers.config.js"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/nunito-sans": "^5.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260713.1",
    "@react-router/dev": "^8.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
