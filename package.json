{
  "name": "mochi-lms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mochi — a warm, family-friendly learning management calendar app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create mochi-class",
    "db:migrate:local": "wrangler d1 migrations apply mochi-class --local",
    "db:migrate": "wrangler d1 migrations apply mochi-class --remote",
    "db:seed:local": "wrangler d1 execute mochi-class --local --file=./seed.sql",
    "db:seed": "wrangler d1 execute mochi-class --remote --file=./seed.sql",
    "lint": "oxlint src worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && vitest run --config vitest.workers.config.js",
    "test:watch": "vitest",
    "test:worker": "vitest run --config vitest.workers.config.js"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/nunito-sans": "^5.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.103.0"
  }
}
