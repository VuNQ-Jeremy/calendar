# Mobile app (Expo) — added in phase 0 so phase 2 can't commit these by accident.
# mobile/ keeps its own node_modules: Metro fights hoisted workspace deps.
mobile/node_modules/
mobile/.expo/
mobile/android/
mobile/ios/

# Remotion video catalog. Standalone npm project like mobile/, so its own
# node_modules; recordings and renders are large and regenerable (video/README.md).
# video/public/recordings/*/manifest.json IS tracked — renders depend on it.
video/node_modules/
video/out/
video/public/recordings/**/*.webm
video/public/music/*.mp3

# Playwright e2e (nav-latency suite runs against a real deployment)
test-results/
playwright-report/
blob-report/
.playwright/
