{
  "include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
  // `mobile` is excluded because the Expo app has its OWN tsconfig (React Native lib types,
  // its own `~/*` paths, jsx: react-jsx via expo/tsconfig.base). Typechecking it from here
  // would resolve neither. Run `cd mobile && npx tsc --noEmit` for that project.
  "exclude": ["node_modules", "build", "dist", ".wrangler", "design", "mobile"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    // Vite/react-router does the transpiling. `tsc` is only ever a type checker here, so
    // never let a bare `tsc` emit .js next to the sources — the `.js` import extensions
    // would then resolve to stale output instead of the .ts files.
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./app/*"],
      "@/*": ["./src/*"]
    }
  }
}
